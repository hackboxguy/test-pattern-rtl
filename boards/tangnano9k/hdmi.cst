// test-pattern-rtl — Tang Nano 9K physical constraints (GW1NR-9C).
// Pins verified against apicula examples/tangnano9k.cst. For nextpnr-himbaechel,
// each TLVDS net (*_p and *_n) is constrained to its own pin (NOT the
// "Ppin,Npin"-on-one-net syntax used by the Gowin-EDA / classic flow).

// HDMI TMDS data pairs
IO_LOC "tmds_d_p[0]" 71;
IO_LOC "tmds_d_n[0]" 70;
IO_LOC "tmds_d_p[1]" 73;
IO_LOC "tmds_d_n[1]" 72;
IO_LOC "tmds_d_p[2]" 75;
IO_LOC "tmds_d_n[2]" 74;

// HDMI TMDS clock pair
IO_LOC "tmds_clk_p" 69;
IO_LOC "tmds_clk_n" 68;

// 27 MHz oscillator
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Buttons (active-low). S1 = reset, S2 = pattern cycle.
IO_LOC "resetn" 4;
IO_PORT "resetn" PULL_MODE=UP;
IO_LOC "key" 3;
IO_PORT "key" PULL_MODE=UP;
